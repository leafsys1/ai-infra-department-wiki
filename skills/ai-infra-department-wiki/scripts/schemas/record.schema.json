{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-infra-wiki/record.schema.json",
  "title": "AI Infra department knowledge record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "status",
    "visibility",
    "owners",
    "created",
    "updated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["case", "evidence", "decision", "pattern", "runbook", "environment"]
    },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "proposed", "observed", "verified", "replicated", "rejected", "deprecated"]
    },
    "visibility": {
      "enum": ["shareable", "internal", "restricted", "local-only"]
    },
    "origin": {
      "enum": ["external_import", "skill_reflection", "mixed"]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVD-[0-9]{4}-[0-9]{4}$" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "relation.schema.json" }
    },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "case" } } },
      "then": { "required": ["context", "validation"] }
    },
    {
      "if": { "properties": { "type": { "const": "evidence" } } },
      "then": { "required": ["source_sha256", "locator"] }
    }
  ],
  "additionalProperties": true
}
