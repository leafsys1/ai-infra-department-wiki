{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-infra-wiki/relation.schema.json",
  "title": "AI Infra knowledge relation",
  "type": "object",
  "required": ["type", "target"],
  "properties": {
    "type": {
      "enum": [
        "validated_by",
        "supports",
        "refutes",
        "applies_to",
        "observed_in",
        "caused_by",
        "mitigated_by",
        "implemented_by",
        "supersedes",
        "contradicts"
      ]
    },
    "target": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVD-[0-9]{4}-[0-9]{4}$" }
    }
  },
  "additionalProperties": false
}
