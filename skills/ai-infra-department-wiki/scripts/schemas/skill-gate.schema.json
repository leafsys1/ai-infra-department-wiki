{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-infra-wiki/skill-gate.schema.json",
  "title": "Held-out skill gate result",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "accepted",
    "verdict",
    "baseline_score",
    "candidate_score",
    "tasks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "verdict": {
      "description": "rejected_not_enough_resolution means the task set could not resolve the candidate; it is not evidence of no benefit.",
      "enum": [
        "accepted_strict_improvement",
        "rejected_critical_regression",
        "rejected_regression",
        "rejected_no_strict_improvement",
        "rejected_not_enough_resolution"
      ]
    },
    "baseline_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidate_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "delta": { "type": "number", "minimum": -1, "maximum": 1 },
    "paired_exact_binomial_p": { "type": "number", "minimum": 0, "maximum": 1 },
    "critical_regressions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resolution": {
      "type": "object",
      "required": ["alpha", "discordant_pairs", "required_discordant_pairs", "enough"],
      "properties": {
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "discordant_pairs": { "type": "integer", "minimum": 0 },
        "required_discordant_pairs": { "type": "integer", "minimum": 0 },
        "statistical_floor": { "type": "integer", "minimum": 0 },
        "enough": { "type": "boolean" },
        "minimum_detectable_effect": { "type": "number", "minimum": 0 },
        "minimum_effect_of_interest": { "type": "number", "minimum": 0 }
      }
    },
    "tasks": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
